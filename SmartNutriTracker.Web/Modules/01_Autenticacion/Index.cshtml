@page "/Modules/01_Autenticacion"
@model SmartNutriTracker.Web.Modules.Autenticacion.IndexModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Módulo 01: Autenticación y Seguridad (Equipo 1)";
}

<div class="space-y-6">
    <!-- Encabezado del Módulo 01 -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 mb-2">
                🛡️ Equipo 1 &bull; HU-01 a HU-05
            </span>
            <h1 class="text-2xl font-extrabold text-slate-900">Módulo 01: Autenticación, Roles y Auditoría</h1>
            <p class="text-sm text-slate-500 mt-1">
                Carpeta aislada de trabajo: <code class="bg-slate-100 px-2 py-0.5 rounded text-emerald-700 font-semibold">Modules/01_Autenticacion/</code>
            </p>
        </div>
        <a href="/swagger" target="_blank" class="px-4 py-2.5 rounded-xl bg-[#059669] hover:bg-[#047857] text-white text-xs font-bold transition shrink-0">
            ⚡ Probar /api/auth en Swagger
        </a>
    </div>

    <!-- Tabla de Usuarios y Roles (HU-01, HU-04) -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <h2 class="text-base font-extrabold text-slate-900 mb-4">👥 Usuarios y Roles Semilla del Sistema (HU-01 / HU-04)</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-200 text-slate-500 uppercase">
                        <th class="py-2.5 px-3">ID</th>
                        <th class="py-2.5 px-3">Nombre Completo</th>
                        <th class="py-2.5 px-3">Correo Institucional</th>
                        <th class="py-2.5 px-3">Rol</th>
                        <th class="py-2.5 px-3">Equipo Asignado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var u in Model.Usuarios)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="py-2.5 px-3 font-bold text-slate-700">#@u.Id</td>
                            <td class="py-2.5 px-3 font-semibold text-slate-900">@u.NombreCompleto</td>
                            <td class="py-2.5 px-3 font-mono text-emerald-700">@u.Email</td>
                            <td class="py-2.5 px-3">
                                <span class="px-2.5 py-0.5 rounded-full font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">@u.Rol</span>
                            </td>
                            <td class="py-2.5 px-3 text-slate-600">@u.EquipoAsignado</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bitácora de Auditoría de Accesos (HU-05) -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <h2 class="text-base font-extrabold text-slate-900 mb-4">📜 Bitácora de Auditoría de Inicios de Sesión (HU-05)</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-200 text-slate-500 uppercase">
                        <th class="py-2.5 px-3">Fecha y Hora</th>
                        <th class="py-2.5 px-3">Correo</th>
                        <th class="py-2.5 px-3">Rol</th>
                        <th class="py-2.5 px-3">Equipo</th>
                        <th class="py-2.5 px-3">Origen</th>
                        <th class="py-2.5 px-3">Resultado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var log in Model.LogsAuditoria)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="py-2.5 px-3 font-mono text-slate-500">@log.FechaHora.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="py-2.5 px-3 font-semibold text-slate-800">@log.Email</td>
                            <td class="py-2.5 px-3">@log.Rol</td>
                            <td class="py-2.5 px-3 text-slate-600">@log.EquipoAsignado</td>
                            <td class="py-2.5 px-3 text-slate-500">@log.Origen</td>
                            <td class="py-2.5 px-3">
                                @if (log.Exitoso)
                                {
                                    <span class="px-2 py-0.5 rounded font-bold bg-emerald-100 text-emerald-800">Exitoso</span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded font-bold bg-red-100 text-red-700">Fallido</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
