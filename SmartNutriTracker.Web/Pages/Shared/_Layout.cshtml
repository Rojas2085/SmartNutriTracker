@using System.Security.Claims
@{
    var nombreUsuario = User.Identity?.Name ?? "Usuario Innovare";
    var rolActual = User.FindFirst(ClaimTypes.Role)?.Value ?? "Estudiante";
    var equipoAsignado = User.FindFirst("EquipoAsignado")?.Value ?? "Equipo General";
    var rutaActual = Context.Request.Path.Value ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartNutriTracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        }
    </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-800 flex flex-col lg:flex-row">

    <!-- BARRA LATERAL (SIDEBAR DE MÓDULOS POR ROL) -->
    <aside class="w-full lg:w-72 bg-white border-b lg:border-b-0 lg:border-r border-slate-200 flex flex-col justify-between shrink-0">
        <div class="p-5">
            <!-- Logo SmartNutriTracker -->
            <a href="/Dashboard" class="flex items-center gap-3 pb-5 border-b border-slate-100">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center shadow-sm">
                    <span class="text-xl">🌱</span>
                </div>
                <div>
                    <span class="text-lg font-extrabold text-[#059669] tracking-tight block leading-none">
                        SmartNutriTracker
                    </span>
                    <span class="text-xs font-medium text-slate-500">
                        Colegio "Innovare"
                    </span>
                </div>
            </a>

            <!-- Tarjeta de sesión activa -->
            <div class="mt-4 p-3.5 rounded-2xl bg-emerald-50/70 border border-emerald-200/70">
                <p class="text-xs font-extrabold text-slate-900 truncate">@nombreUsuario</p>
                <div class="flex items-center justify-between mt-1">
                    <span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-[#059669] text-white">
                        Rol: @rolActual
                    </span>
                    <span class="text-[11px] font-semibold text-emerald-800 truncate ml-2">
                        @equipoAsignado
                    </span>
                </div>
            </div>

            <!-- Navegación Dinámica por Rol hacia los 6 Módulos -->
            <nav class="mt-5 space-y-1">
                <p class="px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                    Navegación Principal
                </p>

                <a href="/Dashboard"
                   class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-bold transition @(rutaActual.StartsWith("/Dashboard", StringComparison.OrdinalIgnoreCase) ? "bg-[#059669] text-white shadow-sm" : "text-slate-700 hover:bg-slate-100")">
                    <span>🏠</span>
                    <span>Dashboard General</span>
                </a>

                <p class="px-3 pt-4 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                    Módulos por Equipo (@rolActual)
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a href="/Modules/01_Autenticacion"
                       class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-semibold transition @(rutaActual.Contains("01_Autenticacion") ? "bg-[#059669] text-white" : "text-slate-700 hover:bg-slate-100")">
                        <span>🛡️</span>
                        <span>01. Autenticación (Equipo 1)</span>
                    </a>
                }

                @if (User.IsInRole("Docente") || User.IsInRole("Admin"))
                {
                    <a href="/Modules/02_PerfilReportes"
                       class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-semibold transition @(rutaActual.Contains("02_PerfilReportes") ? "bg-[#059669] text-white" : "text-slate-700 hover:bg-slate-100")">
                        <span>📋</span>
                        <span>02. Perfil y Reportes (Equipo 2)</span>
                    </a>
                }

                @if (User.IsInRole("Nutricionista") || User.IsInRole("Admin"))
                {
                    <div class="space-y-1">
                        <a href="/Modules/03_Alimentos"
                           class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition @(rutaActual.Contains("03_Alimentos") && !rutaActual.Contains("Menus") && !rutaActual.Contains("CrearMenu") ? "bg-[#059669] text-white" : "text-slate-700 hover:bg-slate-100")">
                            <span>🍎</span>
                            <span>03. Alimentos (Catálogo)</span>
                        </a>
                        @if (rutaActual.Contains("03_Alimentos"))
                        {
                            <div class="pl-7 space-y-1">
                                <a href="/Modules/03_Alimentos/Menus"
                                   class="block px-2.5 py-1 rounded-lg text-[11px] font-medium transition @(rutaActual.Contains("Menus") ? "text-emerald-700 bg-emerald-50 font-bold" : "text-slate-500 hover:text-slate-900")">
                                    🍲 Menús Diarios
                                </a>
                                <a href="/Modules/03_Alimentos/CrearMenu"
                                   class="block px-2.5 py-1 rounded-lg text-[11px] font-medium transition @(rutaActual.Contains("CrearMenu") ? "text-emerald-700 bg-emerald-50 font-bold" : "text-slate-500 hover:text-slate-900")">
                                    ✨ + Crear Menú (Wizard)
                                </a>
                            </div>
                        }
                    </div>
                }

                @if (User.IsInRole("Estudiante") || User.IsInRole("Admin"))
                {
                    <a href="/Modules/04_Habitos"
                       class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-semibold transition @(rutaActual.Contains("04_Habitos") ? "bg-[#059669] text-white" : "text-slate-700 hover:bg-slate-100")">
                        <span>🏃</span>
                        <span>04. Hábitos Diarios (Equipo 4)</span>
                    </a>
                }

                @if (User.IsInRole("Nutricionista") || User.IsInRole("Estudiante") || User.IsInRole("Admin"))
                {
                    <a href="/Modules/05_Recomendaciones"
                       class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-semibold transition @(rutaActual.Contains("05_Recomendaciones") ? "bg-[#059669] text-white" : "text-slate-700 hover:bg-slate-100")">
                        <span>💡</span>
                        <span>05. Recomendaciones (Equipo 5)</span>
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a href="/Modules/06_Notificaciones"
                       class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-semibold transition @(rutaActual.Contains("06_Notificaciones") ? "bg-[#059669] text-white" : "text-slate-700 hover:bg-slate-100")">
                        <span>🔔</span>
                        <span>06. Notificaciones y QA (Equipo 6)</span>
                    </a>
                }
            </nav>
        </div>

        <!-- Pie de Barra Lateral: Swagger + Cerrar Sesión -->
        <div class="p-5 border-t border-slate-100 space-y-2.5">
            <a href="/swagger" target="_blank"
               class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100 transition">
                <span>⚡ Swagger UI (API REST)</span>
            </a>

            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-red-50 text-red-700 border border-red-200 hover:bg-red-600 hover:text-white transition">
                    <span>Cerrar Sesión</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ÁREA DE CONTENIDO PRINCIPAL -->
    <div class="flex-1 flex flex-col min-w-0">
        <main class="flex-1 p-6 lg:p-8 max-w-6xl w-full mx-auto">
            @RenderBody()
        </main>

        <footer class="py-4 px-8 border-t border-slate-200 bg-white text-center text-xs text-slate-400">
            SmartNutriTracker &bull; Colegio "Innovare" &bull; Arquitectura Modular .NET 8 para 6 Equipos de Desarrollo
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
