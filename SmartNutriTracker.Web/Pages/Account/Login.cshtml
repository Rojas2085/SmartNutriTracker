@page "/Account/Login"
@model SmartNutriTracker.Web.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - SmartNutriTracker | Colegio Innovare";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        .split-left-bg {
            background: linear-gradient(145deg, #e7f6ed 0%, #d5eee0 55%, #cce9d9 100%);
        }
        .pill-btn {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .pill-btn.active {
            background-color: #059669 !important;
            color: #ffffff !important;
            border-color: #059669 !important;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.28);
            transform: translateY(-1px);
        }
        .team-pill.active {
            background-color: #059669 !important;
            color: #ffffff !important;
            border-color: #059669 !important;
            box-shadow: 0 3px 10px rgba(5, 150, 105, 0.25);
        }
    </style>
</head>
<body class="min-h-screen bg-[#f3f6f4] flex flex-col lg:flex-row overflow-x-hidden">

    <!-- PANEL IZQUIERDO: Branding SmartNutriTracker - Colegio Innovare -->
    <section class="split-left-bg lg:w-[54%] w-full flex flex-col justify-between items-center p-8 lg:p-12 relative overflow-hidden">
        <!-- Decoración sutil de fondo -->
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-emerald-300/25 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-8 right-8 w-80 h-80 bg-teal-300/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Encabezado Principal -->
        <div class="text-center max-w-xl mx-auto z-10 mt-2 lg:mt-6">
            <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700/10 text-emerald-800 border border-emerald-600/20 mb-3">
                <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
                Plataforma Escolar de Nutrición y Salud
            </span>
            <h1 class="text-3xl lg:text-4xl font-extrabold text-slate-800 tracking-tight leading-tight">
                ¡Tu bienestar, nuestro compromiso!
            </h1>
            <p class="mt-2.5 text-base lg:text-lg text-slate-600 font-medium">
                Monitorea, aprende y crece saludable
            </p>
        </div>

        <!-- Ilustración Central del Colegio Innovare -->
        <div class="my-6 z-10 w-full max-w-lg flex flex-col items-center">
            <div class="relative rounded-3xl overflow-hidden shadow-lg border-4 border-white/80 bg-white/40 backdrop-blur-sm">
                <img src="/images/illustration.jpg"
                     alt="Estudiantes Colegio Innovare - Metas Diarias y Hábitos Semanales"
                     class="w-full h-auto object-contain max-h-[370px]" />
            </div>

            <!-- Tarjetas de resumen nutricional e indicadores -->
            <div class="grid grid-cols-3 gap-3 w-full mt-5">
                <div class="bg-white/90 backdrop-blur rounded-2xl p-3.5 shadow-sm border border-emerald-100 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 font-bold text-lg">
                        🥗
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-800">Semáforo Nutricional</p>
                        <p class="text-[11px] text-slate-500">Alimentos e IMC escolar</p>
                    </div>
                </div>
                <div class="bg-white/90 backdrop-blur rounded-2xl p-3.5 shadow-sm border border-emerald-100 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center shrink-0 font-bold text-lg">
                        💧
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-800">Hábitos Diarios</p>
                        <p class="text-[11px] text-slate-500">Agua, sueño y actividad</p>
                    </div>
                </div>
                <div class="bg-white/90 backdrop-blur rounded-2xl p-3.5 shadow-sm border border-emerald-100 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 font-bold text-lg">
                        📊
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-800">6 Equipos Integrados</p>
                        <p class="text-[11px] text-slate-500">Web Razor + API JWT</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pie izquierdo -->
        <div class="text-center text-xs text-slate-500 z-10">
            SmartNutriTracker v1.0 &bull; Unidad Educativa <strong>Colegio "Innovare"</strong> &bull; Arquitectura .NET 8
        </div>
    </section>

    <!-- PANEL DERECHO: Tarjeta de Inicio de Sesión -->
    <section class="lg:w-[46%] w-full flex items-center justify-center p-6 lg:p-10 bg-[#f4f7f5]">
        <div class="w-full max-w-[490px] bg-white rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.08)] border border-slate-100 p-7 lg:p-9">

            <!-- Logo SmartNutriTracker - Colegio Innovare -->
            <div class="flex items-center justify-center gap-3 mb-5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-center shadow-sm">
                    <svg class="w-8 h-8 text-[#059669]" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M29 7C20 7 12 11 9 20C7.5 24.5 8 29 8 29C8 29 12.5 29.5 17 28C26 25 30 17 29 7Z" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="#d1fae5"/>
                        <path d="M8 29L18 19" stroke="#059669" stroke-width="2.2" stroke-linecap="round"/>
                        <path d="M11 23H15L17.5 18L20.5 26L23 21H27" stroke="#047857" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div>
                    <div class="text-2xl font-extrabold text-[#059669] tracking-tight leading-none">
                        SmartNutriTracker
                    </div>
                    <div class="text-sm font-medium text-slate-600 mt-0.5">
                        Colegio Innovare
                    </div>
                </div>
            </div>

            <!-- Título del Formulario -->
            <div class="text-center mb-5">
                <h2 class="text-2xl font-extrabold text-slate-900">Iniciar Sesión</h2>
                <p class="text-sm text-slate-500 mt-1">¡Hola! Ingresa tus datos para acceder.</p>
            </div>

            <!-- Selector de Rol Visual (Igual al Mockup: Estudiante, Docente, Nutricionista, Admin) -->
            <div class="flex flex-wrap items-center justify-center gap-1.5 mb-4">
                <span class="text-xs font-bold text-slate-600 mr-1">Soy:</span>
                <button type="button" onclick="seleccionarEquipo(4)" id="rol-Estudiante"
                        class="pill-btn active px-3.5 py-1.5 rounded-full text-xs font-semibold border border-emerald-600/40 bg-emerald-50 text-emerald-800 hover:bg-emerald-100">
                    Estudiante
                </button>
                <button type="button" onclick="seleccionarEquipo(2)" id="rol-Docente"
                        class="pill-btn px-3.5 py-1.5 rounded-full text-xs font-semibold border border-emerald-600/40 bg-emerald-50 text-emerald-800 hover:bg-emerald-100">
                    Docente
                </button>
                <button type="button" onclick="seleccionarEquipo(3)" id="rol-Nutricionista"
                        class="pill-btn px-3.5 py-1.5 rounded-full text-xs font-semibold border border-emerald-600/40 bg-emerald-50 text-emerald-800 hover:bg-emerald-100">
                    Nutricionista
                </button>
                <button type="button" onclick="seleccionarEquipo(1)" id="rol-Admin"
                        class="pill-btn px-3.5 py-1.5 rounded-full text-xs font-semibold border border-emerald-600/40 bg-emerald-50 text-emerald-800 hover:bg-emerald-100">
                    Admin
                </button>
            </div>

            <!-- SELECTOR RÁPIDO DE DESARROLLO (6 Equipos del Proyecto) -->
            <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-3.5 mb-5">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                        ⚡ Acceso Rápido por Equipo (Autocompletar)
                    </span>
                    <span id="badge-hu" class="text-[11px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-md">
                        HU-19, HU-20, HU-21
                    </span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
                    <button type="button" onclick="seleccionarEquipo(1)" id="team-1"
                            class="team-pill px-2.5 py-1.5 rounded-xl text-[11px] font-semibold border border-slate-200 bg-white text-slate-700 hover:border-emerald-500 text-left truncate">
                        🛡️ Equipo 1 (Admin)
                    </button>
                    <button type="button" onclick="seleccionarEquipo(2)" id="team-2"
                            class="team-pill px-2.5 py-1.5 rounded-xl text-[11px] font-semibold border border-slate-200 bg-white text-slate-700 hover:border-emerald-500 text-left truncate">
                        📋 Equipo 2 (Docente)
                    </button>
                    <button type="button" onclick="seleccionarEquipo(3)" id="team-3"
                            class="team-pill px-2.5 py-1.5 rounded-xl text-[11px] font-semibold border border-slate-200 bg-white text-slate-700 hover:border-emerald-500 text-left truncate">
                        🍎 Equipo 3 (Alimentos)
                    </button>
                    <button type="button" onclick="seleccionarEquipo(4)" id="team-4"
                            class="team-pill active px-2.5 py-1.5 rounded-xl text-[11px] font-semibold border border-slate-200 bg-white text-slate-700 hover:border-emerald-500 text-left truncate">
                        🏃 Equipo 4 (Hábitos)
                    </button>
                    <button type="button" onclick="seleccionarEquipo(5)" id="team-5"
                            class="team-pill px-2.5 py-1.5 rounded-xl text-[11px] font-semibold border border-slate-200 bg-white text-slate-700 hover:border-emerald-500 text-left truncate">
                        💡 Equipo 5 (Recomend.)
                    </button>
                    <button type="button" onclick="seleccionarEquipo(6)" id="team-6"
                            class="team-pill px-2.5 py-1.5 rounded-xl text-[11px] font-semibold border border-slate-200 bg-white text-slate-700 hover:border-emerald-500 text-left truncate">
                        🔔 Equipo 6 (QA/Alertas)
                    </button>
                </div>
            </div>

            <!-- Alerta de Error si las credenciales fallan -->
            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="mb-4 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-medium flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>@Model.MensajeError</span>
                </div>
            }

            <!-- FORMULARIO RAZOR CON ANTI-FORGERY TOKEN -->
            <form method="post" class="space-y-4" novalidate>
                @Html.AntiForgeryToken()

                <!-- Campo Correo Electrónico -->
                <div>
                    <label asp-for="Input.Email" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Correo electrónico
                    </label>
                    <input asp-for="Input.Email"
                           id="inputEmail"
                           type="email"
                           placeholder="ejemplo@innovare.edu.bo"
                           autocomplete="username"
                           class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#059669] focus:border-transparent transition" />
                    <span asp-validation-for="Input.Email" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <!-- Campo Contraseña -->
                <div>
                    <label asp-for="Input.Password" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Contraseña
                    </label>
                    <div class="relative">
                        <input asp-for="Input.Password"
                               id="inputPassword"
                               type="password"
                               placeholder="••••••••••••"
                               autocomplete="current-password"
                               class="w-full px-4 py-3 pr-11 rounded-xl border border-slate-300 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#059669] focus:border-transparent transition" />
                        <button type="button"
                                onclick="togglePasswordVisibility()"
                                title="Mostrar / Ocultar contraseña"
                                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none">
                            <svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-xs text-red-600 mt-1 block"></span>

                    <div class="flex items-center justify-between mt-2">
                        <label class="inline-flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                            <input asp-for="Input.Recordarme" type="checkbox" class="rounded border-slate-300 text-[#059669] focus:ring-[#059669]" />
                            <span>Mantener sesión activa</span>
                        </label>
                        <a href="javascript:void(0)" onclick="mostrarAyudaPassword()" class="text-xs font-medium text-slate-500 underline hover:text-[#059669]">
                            Olvidé mi contraseña
                        </a>
                    </div>
                </div>

                <!-- Botón Iniciar Sesión -->
                <button type="submit"
                        class="w-full py-3.5 px-6 rounded-full bg-[#059669] hover:bg-[#047857] active:scale-[0.99] text-white font-bold text-base shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                    <span>Iniciar Sesión</span>
                </button>
            </form>

            <!-- Enlaces inferiores y Acceso a Swagger API -->
            <div class="mt-5 pt-4 border-t border-slate-100 text-center space-y-2">
                <p class="text-xs text-slate-500">
                    ¿No tienes una cuenta?
                    <a href="javascript:void(0)" onclick="seleccionarEquipo(1)" class="font-semibold text-slate-700 underline hover:text-[#059669]">
                        Contacta al administrador.
                    </a>
                </p>
                <div class="pt-1">
                    <a href="/swagger" target="_blank"
                       class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:text-emerald-800 bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-lg transition">
                        <span>⚡ Explorar API REST &amp; JWT en Swagger UI</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                        </svg>
                    </a>
                </div>
            </div>

        </div>
    </section>

    <script>
        const cuentasEquipos = {
            1: { email: 'equipo1.admin@innovare.edu.bo', pass: 'Innovare2026*', rol: 'Admin', hus: 'HU-01, HU-04, HU-05' },
            2: { email: 'equipo2.docente@innovare.edu.bo', pass: 'Innovare2026*', rol: 'Docente', hus: 'HU-08, HU-12' },
            3: { email: 'equipo3.nutri@innovare.edu.bo', pass: 'Innovare2026*', rol: 'Nutricionista', hus: 'HU-14, HU-15, HU-16, HU-17' },
            4: { email: 'equipo4.est@innovare.edu.bo', pass: 'Innovare2026*', rol: 'Estudiante', hus: 'HU-19, HU-20, HU-21' },
            5: { email: 'equipo5.nutri@innovare.edu.bo', pass: 'Innovare2026*', rol: 'Nutricionista', hus: 'HU-23, HU-24, HU-26' },
            6: { email: 'equipo6.qa@innovare.edu.bo', pass: 'Innovare2026*', rol: 'Admin', hus: 'HU-27, HU-28, HU-29, HU-32' }
        };

        function seleccionarEquipo(numEquipo) {
            const cuenta = cuentasEquipos[numEquipo];
            if (!cuenta) return;

            const emailInput = document.getElementById('inputEmail');
            const passInput = document.getElementById('inputPassword');
            const badgeHu = document.getElementById('badge-hu');

            emailInput.value = cuenta.email;
            passInput.value = cuenta.pass;
            if (badgeHu) {
                badgeHu.textContent = `Rol: ${cuenta.rol} • ${cuenta.hus}`;
            }

            // Actualizar estado visual de los 6 botones de equipo
            document.querySelectorAll('.team-pill').forEach(btn => btn.classList.remove('active'));
            const activeTeamBtn = document.getElementById(`team-${numEquipo}`);
            if (activeTeamBtn) activeTeamBtn.classList.add('active');

            // Actualizar estado visual de las píldoras de Rol ("Soy: ...")
            document.querySelectorAll('.pill-btn').forEach(btn => btn.classList.remove('active'));
            const activeRoleBtn = document.getElementById(`rol-${cuenta.rol}`);
            if (activeRoleBtn) activeRoleBtn.classList.add('active');
        }

        function togglePasswordVisibility() {
            const passInput = document.getElementById('inputPassword');
            if (passInput.type === 'password') {
                passInput.type = 'text';
            } else {
                passInput.type = 'password';
            }
        }

        function mostrarAyudaPassword() {
            alert('Contraseña semilla para los 6 equipos de desarrollo del Colegio Innovare:\n\nInnovare2026*\n\nHaz clic en cualquiera de los 6 botones de equipo para autocompletar.');
        }

        // Autocompletar por defecto el Equipo 4 (Estudiante) si el campo está vacío al cargar
        window.addEventListener('DOMContentLoaded', () => {
            const emailInput = document.getElementById('inputEmail');
            if (!emailInput.value) {
                seleccionarEquipo(4);
            }
        });
    </script>
</body>
</html>
